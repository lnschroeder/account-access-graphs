    ],
    "rules": [
      {
        "description": "At least one primary authentication method must be chosen.",
        "logic": {
          ">": [
            {
              "+": [
                { "var": "simple" },
                { "var": "secKeyOtp" },
                { "var": "tOtp" },
                { "var": "smsOtp" }
              ]
            },
            0
          ]
        }
      },
      {
        "description": "2FA authentication methods are mutually exclusive with the password-only method",
        "logic": {
          "if": [
            { "var": "simple" },
            {
              "==": [
                {
                  "+": [
                    { "var": "secKeyOtp" },
                    { "var": "tOtp" },
                    { "var": "smsOtp" }
                  ]
                },
                0
              ]
            },
            true
          ]
        }
      }
