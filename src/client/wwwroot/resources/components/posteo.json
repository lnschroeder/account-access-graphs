      "answer": false
    },
    {
      "name": "thirdPartyApp",
      "description": "Do you use 3rd-party apps for accessing your emails?",
      "answer": false
    }
  ],
  "rules": [
    {
      "description": "You can only use third party apps, if you have also enabled the option",
      "logic": {
        "if": [
          { "var": "thirdPartyApp" },
          { "var": "enabledThirdPartyApps" },
          true
        ]
      }
    },
    {
      "description": "You have enabled third party apps, but don't use them. Disable this feature.",
      "logic": {
        "if": [
          { "var": "enabledThirdPartyApps" },
          { "var": "thirdPartyApp" },
          true
        ]
      }
    },
    {
      "description": "Exactly one primary authentication method must be used.",
      "logic": {
        "==": [{ "+": [{ "var": "F1" }, { "var": "tfa" }] }, 1]
      }
    }
  ],
