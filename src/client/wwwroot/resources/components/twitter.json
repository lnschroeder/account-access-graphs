  "rules": [
    {
      "description": "2FA via SMS is only available for Twitter Blue users",
      "logic": {
        "if": [
          { "var": "smsOtp" },
          { "var": "isBlue" },
          true
        ]
      }
    },
    {
      "description": "At least one primary method must be chosen",
      "logic": {
        ">": [
          { "+": [
              { "var": "simple" },
              { "var": "tOtp" },
              { "var": "smsOtp" }
            ]
          },
          0
        ]
      }
    },
    {
      "description": "2FA authentication methods are mutually exclusive with the password-only method",
      "logic": {
        "if": [
          { "var": "simple" },
          {
            "==": [
              { "+": [
                  { "var": "tOtp" },
                  { "var": "smsOtp" }
                ]
              },
              0
            ]
          },
          true
        ]
      }
    }
